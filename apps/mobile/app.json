{
  "expo": {
    "name": "ytmsc",
    "slug": "ytmsc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030303",
    "splash": {
      "backgroundColor": "#030303",
      "resizeMode": "contain",
      "image": "./assets/splash-image.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sultanxzk.ytmsc"
    },
    "android": {
      "package": "com.sultanxzk.ytmsc",
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030303"
      },
      "versionCode": 9
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "backgroundModes": [
            "audio"
          ]
        }
      ],
      [
        "expo-file-system",
        {
          "backgroundModes": [
            "audio"
          ]
        }
      ]
    ],
    "scheme": "ytmsc",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5418531b-4eb8-4b4b-bef7-21a5dcfae955"
      }
    },
    "owner": "sultanxzk"
  }
}
