{
  "cli": { "version": ">= 3.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "variant": "debug" },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": { "variant": "debug" },
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "android": { "variant": "release" },
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": { "production": {} }
}
