# Client ID do Google (https://console.cloud.google.com/apis/credentials
# -> Criar credenciais -> ID do cliente OAuth -> Aplicação da Web
# Authorized JavaScript origins: http://127.0.0.1:5175 e http://localhost:5175
# Authorized redirect URIs: mesmo valor
VITE_GOOGLE_CLIENT_ID=

# Sync cross-device (Vercel + Upstash Redis)
# https://upstash.com/redis → criar DB → copiar REST URL/Token → env vars no Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mobile: API base (https://ytmsc.vercel.app em produção)
EXPO_PUBLIC_API_URL=
